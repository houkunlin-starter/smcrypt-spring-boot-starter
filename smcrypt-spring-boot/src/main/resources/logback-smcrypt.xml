<?xml version="1.0" encoding="UTF-8"?>
<!--
  启动早期日志配置（logback-smcrypt.xml，配置文件密文解密专用）

  在 Spring Boot 完整日志系统初始化（LoggingApplicationListener 加载 logback-spring.xml）之前，
  由 SmCryptLogback 手动加载本配置，使 EnvironmentPostProcessor 阶段（配置文件密文解密）
  的日志也能正常输出。

  生命周期：
  - 该配置由 SmCryptLogback 加载到独立的 LoggerContext，与全局日志系统隔离；
  - 在 postProcessEnvironment 执行期间生效，方法结束后上下文即被关闭（closeLogging），
    因此不会在后台持续进行日志滚动/归类；
  - Spring Boot 后续仍会基于 logback-spring.xml 正常初始化全局日志，完整格式自动接管。

  变量说明（由 SmCryptLogback#applyLoggingProperties 注入或内置默认值）：
  - ${APPLICATION_NAME}          应用名（spring.application.name），用于日志文件名前缀
  - ${LOG_PATH}                  日志文件输出目录（logging.file.path），默认 logs
  - ${LOG_TEMP}                  临时目录（java.io.tmpdir），LOG_PATH 未配置时的兜底
  - ${LOGBACK_ROLLINGPOLICY_*}   滚动策略（logging.logback.rollingpolicy.*）
-->
<configuration>
    <property name="BASE_LOG_PATH" value="${LOG_PATH:-${LOG_TEMP:-${java.io.tmpdir:-/tmp}}}"/>
    <property name="EARLY_LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} %5level %logger{36} : %msg%n"/>

    <!-- 控制台输出：格式简单，便于启动早期快速查看关键日志 -->
    <appender name="EARLY_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${EARLY_LOG_PATTERN}</pattern>
            <!-- 控制台字符集与全局业务日志保持同步：
                 ${CONSOLE_LOG_CHARSET} 为 Spring Boot 根据 logging.charset.console 设置的系统属性；
                 未配置时回退到 JVM 的 file.encoding，再兜底 UTF-8。 -->
            <charset>${CONSOLE_LOG_CHARSET:-${file.encoding:-UTF-8}}</charset>
        </encoder>
    </appender>

    <!-- 文件输出：按日期+大小滚动，文件名形如 {应用名}.smcrypt.log -->
    <appender name="EARLY_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${BASE_LOG_PATH}/${APPLICATION_NAME}.smcrypt.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${BASE_LOG_PATH}/${APPLICATION_NAME}.smcrypt.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <cleanHistoryOnStart>${LOGBACK_ROLLINGPOLICY_CLEAN_HISTORY_ON_START:-false}</cleanHistoryOnStart>
            <maxFileSize>${LOGBACK_ROLLINGPOLICY_MAX_FILE_SIZE:-10MB}</maxFileSize>
            <totalSizeCap>${LOGBACK_ROLLINGPOLICY_TOTAL_SIZE_CAP:-0}</totalSizeCap>
            <maxHistory>${LOGBACK_ROLLINGPOLICY_MAX_HISTORY:-7}</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${EARLY_LOG_PATTERN}</pattern>
            <!-- 文件字符集与全局业务日志文件保持同步：
                 ${FILE_LOG_CHARSET} 为 Spring Boot 根据 logging.charset.file 设置的系统属性；
                 未配置时回退到 JVM 的 file.encoding，再兜底 UTF-8。 -->
            <charset>${FILE_LOG_CHARSET:-${file.encoding:-UTF-8}}</charset>
        </encoder>
    </appender>

    <root level="DEBUG">
        <appender-ref ref="EARLY_CONSOLE"/>
        <appender-ref ref="EARLY_FILE"/>
    </root>
</configuration>
